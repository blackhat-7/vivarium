#!/usr/bin/env bash
# Submit the current branch for one host-approved GitHub push.
set -euo pipefail

SOCKET=${VIVARIUM_PUSH_GATE_SOCKET:-/run/vivarium-push-gate/request.sock}
MAX_BUNDLE_BYTES=$((100 * 1024 * 1024))
ZERO_OID=0000000000000000000000000000000000000000
fatal() { echo "vpush: $*" >&2; exit 1; }

[[ $# -eq 0 ]] || fatal "usage: vpush"
[[ -S "$SOCKET" ]] || fatal "push gate is unavailable; ask the host user to run scripts/push-gate.sh start"
root=$(/usr/bin/git rev-parse --show-toplevel 2>/dev/null) || fatal "not inside a Git repository"
branch=$(/usr/bin/git -C "$root" symbolic-ref --quiet --short HEAD) || fatal "detached HEAD is not supported"
/usr/bin/git check-ref-format --branch "$branch" >/dev/null || fatal "invalid branch"
ref="refs/heads/$branch"
new_oid=$(/usr/bin/git -C "$root" rev-parse --verify 'HEAD^{commit}') || fatal "HEAD is not a commit"

origin=$(/usr/bin/git -C "$root" remote get-url origin) || fatal "origin is not configured"
case "$origin" in
  https://github.com/*) path=${origin#https://github.com/} ;;
  *) fatal "origin must be https://github.com/OWNER/REPO(.git)" ;;
esac
path=${path%.git}
[[ "$path" == */* && "$path" != */*/* ]] || fatal "origin must name one GitHub owner and repository"
owner=${path%%/*}; repo=${path#*/}
[[ "$owner" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]] || fatal "unsupported GitHub owner"
[[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ ]] || fatal "unsupported GitHub repository"
canonical="https://github.com/$owner/$repo.git"

line=$(GIT_TERMINAL_PROMPT=0 /usr/bin/git -C "$root" \
  -c credential.helper= -c 'credential.helper=cache --timeout=86400' \
  ls-remote --refs "$canonical" "$ref") || fatal "cannot read the remote branch"
old_oid=$ZERO_OID
if [[ -n "$line" ]]; then
  [[ $(printf '%s\n' "$line" | wc -l) -eq 1 ]] || fatal "remote advertised the branch more than once"
  read -r old_oid old_ref extra <<<"$line"
  [[ -z "${extra:-}" && "$old_ref" == "$ref" && "$old_oid" =~ ^[0-9a-f]{40}$ ]] || fatal "invalid remote response"
fi
[[ "$new_oid" != "$old_oid" ]] || fatal "$branch is already up to date"

umask 077
bundle=$(mktemp "${TMPDIR:-/tmp}/vpush.XXXXXX.bundle")
trap 'rm -f "$bundle"' EXIT
/usr/bin/git -C "$root" -c core.hooksPath=/dev/null bundle create "$bundle" HEAD >/dev/null 
size=$(stat -c '%s' "$bundle")
(( size <= MAX_BUNDLE_BYTES )) || fatal "bundle exceeds the 100 MiB MVP limit"

response=$(/usr/bin/curl --silent --show-error --fail-with-body --unix-socket "$SOCKET" \
  --connect-timeout 3 --max-time 120 -X POST -H 'Content-Type: application/x-git-bundle' \
  -H "X-Vivarium-Profile: ${VIVARIUM_PROFILE:-default}" \
  -H "X-Vivarium-Owner: $owner" -H "X-Vivarium-Repo: $repo" -H "X-Vivarium-Ref: $ref" \
  -H "X-Vivarium-Old-Oid: $old_oid" -H "X-Vivarium-New-Oid: $new_oid" \
  --data-binary "@$bundle" http://localhost/requests) || fatal "request submission failed"
printf '%s' "$response" | /usr/bin/jq -e '.id | select(test("^[0-9a-f]{32}$"))' >/dev/null || fatal "invalid broker response"
approval_url=$(printf '%s' "$response" | /usr/bin/jq -er '.approval_url | select(type == "string")') || fatal "invalid broker response"
printf '[push-gate] request submitted; no push has happened yet.\n[push-gate] approve or deny: %s\n' "$approval_url"

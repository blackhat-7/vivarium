# compose.yaml reads .env. This file is the template. `scripts/up.sh` creates
# .env on first run with sensible defaults — you shouldn't need to edit it
# unless you want to change which agents get installed.

HOST_UID=1000
HOST_GID=1000

# Optional profile identity. Defaults are generated by scripts/profile.sh.
# COMPOSE_PROJECT_NAME=vivarium
# CONTAINER_NAME=vivarium

# Which agent CLIs to bake into the image. AT LEAST ONE must be true —
# scripts/up.sh fails fast with a [FATAL] message if both are false.
# If an install fails mid-build, the build fails with a [FATAL] message
# pointing at which flag to flip.
INSTALL_OPENCODE=true
INSTALL_CLAUDE=false

# paseo — multi-agent (claude/codex/opencode) daemon that pairs with
# desktop/mobile/web clients via QR code. Off by default. Independent of
# the agent CLIs above: paseo orchestrates whichever ones are installed.
# Enable both the build flag (here) and the runtime flag (PASEO_ENABLE
# below) to actually start the daemon. See DOCS.md "Paseo remote-access".
INSTALL_PASEO=false

# bestiary — extensible MCP server (https://github.com/blackhat-7/bestiary).
# Off by default. BESTIARY_REF accepts a branch ("main"), tag ("v0.1.0"),
# or SHA. update.sh resolves branch/tag refs to a commit SHA at build time
# so docker's layer cache invalidates correctly when upstream moves —
# without that, "main" is a stale cache key forever. Pin to a tag for
# strict reproducibility; track "main" if you want each `update.sh` run
# to pick up upstream commits.
INSTALL_BESTIARY=false
BESTIARY_REF=main

# ai-harnesses — shared agent config baked into the image in yolo mode.
# MCP selection is build-time/static so an in-container agent cannot enable
# disabled MCPs by editing runtime config files.
AI_HARNESSES_REF=main
# none | all | comma-list, e.g. github,bestiary
AI_HARNESSES_MCP=none

# Optional GitHub HTTPS clone token. scripts/up.sh pipes this into git's
# in-container credential cache, then agents can run normal `git clone` and
# read-only `gh` commands. scripts/shell.sh also re-primes already-running
# containers automatically; scripts/git-auth.sh can re-prime manually after
# credential-cache expiry.
# It is intentionally NOT passed as a normal container environment variable.
# Use a fine-grained, repo-scoped, read-only PAT: Metadata: read + Contents: read.
# Optionally add Issues: read / Pull requests: read for read-only gh issue/PR use.
# Set all-repo read access only if you want to clone any private repo in your account.
# GITHUB_READ_TOKEN=

# Optional host-wide push gate is configured once, outside profile env files:
#   ~/.config/vivarium/push-gate.env
# Enable it with: ./scripts/push-gate.sh enable
# For remote access, set its bind address to one specific Tailscale IP and its
# public URL to http://hostname:7843. Never bind it to 0.0.0.0.

# Optional provider and MCP tokens. Keep these low-blast-radius; they are passed
# into the container runtime for both shell sessions and Paseo-spawned agents.
# CHUTES_API_KEY=
# GITHUB_MCP_TOKEN=
# AFTERSHOOT_MCP_API_KEY=
# LINEAR_API_KEY=

# OpenCode web — enabled by default when opencode is installed. It is
# unauthenticated and published on port 4096. Keep it on localhost or a trusted
# tailnet-only bind.
# OPENCODE_WEB_ENABLE=true
# OPENCODE_WEB_BIND_ADDR=127.0.0.1  # set to your tailscale IP for tailnet-only
# OPENCODE_WEB_PORT=4096            # host port; container still listens on 4096

# If you want the vivarium home somewhere other than ~/vivarium-home:
# VIVARIUM_HOME=/mnt/bigdisk/vivarium-home

# Optional: run `paseo daemon start --foreground --no-relay` from the
# container, paired by QR code from the paseo app on phone/desktop/web.
# Auth is the pairing crypto (NaCl box / XSalsa20-Poly1305) — no password
# to leak, but anyone who can scan the QR while it's on screen gets a key.
# So: only show the QR over trusted channels (`docker compose logs vivarium`).
#
# Tailscale-only setup (rootful Docker, e.g. on Hetzner): set
# PASEO_BIND_ADDR to this host's tailscale IPv4 (find it with
# `tailscale ip -4`). The container's :6767 then binds *only* to the
# tailscale interface — not LAN, not WAN. Phones / laptops on the same
# tailnet reach it directly; no host-side forwarder, no Caddy needed.
# `--no-relay` keeps the daemon from dialing paseo.sh's hosted relay,
# so traffic stays inside your tailnet.
#
# PASEO_HOSTNAMES is paseo's Host-header allowlist; the entrypoint
# defaults it to "true" (any host) because the network bind IS the
# auth gate. Tighten by listing exact hosts (comma-separated) if you
# want defense-in-depth.
# PASEO_ENABLE=false
# PASEO_BIND_ADDR=127.0.0.1     # set to your tailscale IP for tailnet-only
# PASEO_PORT=6767               # use a different host port for parallel profiles
# PASEO_HOSTNAMES=

# NOTE: do NOT put per-project API secrets here. They'd persist into every
# session. Keep secrets in manually managed env files (for example, a
# project-local .env ignored by that repo) and source them only for sessions
# that need them.
